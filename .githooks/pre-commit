#!/bin/sh
# Cache busting: rewrites the ?v= query on style.css and app.js in index.html
# to a short hash of each file's staged content, so browsers and GitHub
# Pages' CDN fetch new copies whenever (and only when) those files change.
#
# One-time setup per clone:  git config core.hooksPath .githooks
#
# Note: index.html is re-staged after the rewrite, so any unstaged edits to
# index.html at commit time are included in the commit.
set -e
cd "$(git rev-parse --show-toplevel)"

for f in style.css app.js; do
  git cat-file -e ":$f" 2>/dev/null || continue
  hash=$(git show ":$f" | git hash-object --stdin | cut -c1-8)
  perl -pi -e "s/\Q$f\E\?v=[A-Za-z0-9]+/$f?v=$hash/g" index.html
done

git add index.html
